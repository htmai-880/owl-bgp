<!--
    The dependencies (OWL API 5.1.9, HermiT 1.4.5.519, Jena, ...) are managed by Maven (see pom.xml).
    This Ant file is a thin wrapper that delegates compilation and packaging to Maven and
    adds the license files to the resulting self-contained jar.
    A JDK 21 (or newer) and Maven are required.
-->
<project name="OWL-BGP" default="combined" basedir=".">
    <property name="version" value="0.1"/>

    <!-- general info -->
    <property name="homepage" value="http://code.google.com/p/owl-bgp/"/>

    <!-- structure of output files -->
    <property name="projectroot" value="."/>
    <property name="builddir" value="${projectroot}/build"/>
    <property name="licensedir" value="${builddir}/licenses"/>
    <property name="mavenbuilddir" value="${projectroot}/target"/>

    <!-- license files of the bundled libraries -->
    <property name="libdir" value="${projectroot}/lib"/>

    <!-- Maven executable (mvn.cmd on Windows) -->
    <condition property="maven.executable" value="mvn.cmd" else="mvn">
        <os family="windows"/>
    </condition>

    <!-- RELEASE TARGETS  -->

    <target name="clean">
        <delete dir="${builddir}"/>
        <exec executable="${maven.executable}" failonerror="true">
            <arg value="-B"/>
            <arg value="clean"/>
        </exec>
    </target>

    <target name="compile">
        <exec executable="${maven.executable}" failonerror="true">
            <arg value="-B"/>
            <arg value="compile"/>
        </exec>
    </target>

    <target name="licenses">
        <mkdir dir="${licensedir}"/>
        <copy file="gpl.txt" tofile="${licensedir}/OWLBGP-GPL.LICENSE"/>
        <copy file="lgpl-3.0.txt" tofile="${licensedir}/OWLBGP-LGPL.LICENSE"/>
        <copy todir="${licensedir}">
            <fileset dir="${libdir}" includes="*.LICENSE"/>
        </copy>
    </target>

    <!-- builds the self-contained jar (maven-shade-plugin) including all dependencies -->
    <target name="combined" depends="clean,licenses">
        <exec executable="${maven.executable}" failonerror="true">
            <arg value="-B"/>
            <arg value="package"/>
            <arg value="-DskipTests"/>
        </exec>
        <mkdir dir="${builddir}"/>
        <copy file="${mavenbuilddir}/owl-bgp-0.1.0-SNAPSHOT.jar" tofile="${builddir}/${ant.project.name}-${version}.jar"/>
        <zip destfile="${builddir}/${ant.project.name}-${version}.jar" update="true">
            <zipfileset dir="${licensedir}" prefix="licenses"/>
            <fileset file="readme.txt"/>
            <fileset file="gpl.txt"/>
            <fileset file="lgpl-3.0.txt"/>
        </zip>
    </target>
</project>
